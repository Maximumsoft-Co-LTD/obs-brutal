{
  "dashboard": {
    "id": null,
    "title": "OBS-Brutal Monitoring Dashboard",
    "tags": ["obs-brutal", "logging", "performance"],
    "timezone": "browser",
    "panels": [
      {
        "id": 1,
        "title": "Requests per Second",
        "type": "stat",
        "targets": [
          {
            "expr": "rate(obs_brutal_requests_total[5m])",
            "legendFormat": "{{method}} {{endpoint}}"
          }
        ],
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0}
      },
      {
        "id": 2,
        "title": "Logs Generated per Second",
        "type": "stat",
        "targets": [
          {
            "expr": "rate(obs_brutal_logs_generated_total[5m])",
            "legendFormat": "Logs/sec"
          }
        ],
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0}
      },
      {
        "id": 3,
        "title": "Request Duration",
        "type": "graph",
        "targets": [
          {
            "expr": "histogram_quantile(0.50, rate(obs_brutal_request_duration_seconds_bucket[5m]))",
            "legendFormat": "50th percentile"
          },
          {
            "expr": "histogram_quantile(0.95, rate(obs_brutal_request_duration_seconds_bucket[5m]))",
            "legendFormat": "95th percentile"
          }
        ],
        "gridPos": {"h": 8, "w": 24, "x": 0, "y": 8}
      },
      {
        "id": 4,
        "title": "OBS-Brutal Logs",
        "type": "logs",
        "targets": [
          {
            "expr": "{service=\"obs-brutal-monitoring\"}",
            "refId": "A"
          }
        ],
        "gridPos": {"h": 12, "w": 24, "x": 0, "y": 16}
      }
    ],
    "time": {
      "from": "now-1h",
      "to": "now"
    },
    "refresh": "5s"
  }
}
